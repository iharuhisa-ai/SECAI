# Supabase（Settings → API から取得）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # または旧 anon(JWT) キー

# Supabase サービスキー（サーバー専用・ユーザー管理で使用。NEXT_PUBLIC を付けない）
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...            # または旧 service_role キー

# Claude API キー（Anthropic Console から取得。AIシフト作成・日報AI補助で使用）
ANTHROPIC_API_KEY=sk-ant-api03-...
